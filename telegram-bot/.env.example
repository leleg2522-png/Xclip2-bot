TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
RENDERFUL_API_KEY=your_renderful_api_key_here
# Optional: public base URL used to build download links for large results.
# On Railway, RAILWAY_PUBLIC_DOMAIN is set automatically and used by default.
# Set PUBLIC_BASE_URL only to override it (e.g. a custom domain). No trailing slash.
PUBLIC_BASE_URL=

# Optional Picsart datacenter backup; keeps existing ISP settings unchanged.
# Put actual credentials in Secrets/hosting Variables, never commit them.
# DECODO_TEST_USERNAME / DECODO_TEST_PASSWORD are also accepted as a pair.
# With no datacenter credentials, existing ISP -> direct behavior is preserved.
DECODO_DC_PROXY_USERNAME=
DECODO_DC_PROXY_PASSWORD=
DECODO_DC_PROXY_HOST=dc.decodo.com
DECODO_DC_PROXY_PORTS=10001,10002,10003,10004,10005,10006,10007,10008,10009,10010
